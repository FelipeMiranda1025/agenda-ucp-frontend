# =============================================
# Backend API — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# =============================================

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agenda_ucp

# Puerto en el que escucha el API
PORT=3001

# Secreto para firmar JWT (cuando se implemente auth en Fase 2)
# Genera uno seguro con: openssl rand -base64 32
JWT_SECRET=cambia-esto-en-produccion

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Entorno: development | production
NODE_ENV=development

# =============================================
# Fase 6 — Subida e interpretación de documentos
# =============================================
# Carpeta dentro del contenedor donde multer guarda los uploads.
# En docker-compose se monta como volumen persistente.
UPLOADS_DIR=/var/app/uploads
MAX_UPLOAD_MB=20

# Proveedor LLM para parse-document (openai | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# =============================================
# Fase 7 — SMTP para correos transaccionales (nodemailer)
# Compatible con Gmail, SendGrid, Mailgun, servidor SMTP institucional UCP, etc.
# =============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false           # true si el puerto es 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agenda UCP <no-reply@ucp.edu.co>"

# URL pública del frontend, usada para construir links de recuperación de contraseña
FRONTEND_URL=http://localhost:8080
