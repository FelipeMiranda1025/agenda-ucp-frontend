# =============================================
# Backend API — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# =============================================

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agenda_ucp

# Puerto en el que escucha el API
PORT=3001

# Secreto para firmar JWT (cuando se implemente auth en Fase 2)
# Genera uno seguro con: openssl rand -base64 32
JWT_SECRET=cambia-esto-en-produccion

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Entorno: development | production
NODE_ENV=development
