# =====================================================================
# Variables del frontend (Vite)
# =====================================================================

# URL del backend Express.
# - Desarrollo local:        http://localhost:4000/api
# - Docker (mismo compose):  /api  (proxy nginx, ver frontend/nginx.conf)
# - Producción UCP:          http://<IP-SERVIDOR>:4000/api
VITE_API_URL=http://localhost:4000/api

# =====================================================================
# Backend Express — referencia rápida
# El backend usa `backend/.env`. Aquí solo se listan las variables
# críticas que el operador del servidor debe configurar.
# =====================================================================

# JWT
JWT_SECRET=cambia-esto-en-produccion

# SMTP (envío de correo de recuperación de contraseña)
# Para Gmail usar una "App Password" (no la contraseña normal de la cuenta).
# En producción, configurar el servidor SMTP institucional de la UCP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=correo-emisor@ucp.edu.co
SMTP_PASS=app-password-aqui
SMTP_FROM="Agenda Docente UCP <no-reply@ucp.edu.co>"
