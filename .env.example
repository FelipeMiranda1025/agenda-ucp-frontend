# Variables de entorno requeridas para el proyecto
# Copia este archivo como .env y completa los valores
#
# Nota: Las claves aquí son públicas (anon key), NO son secretas.
# El archivo .env ya viene incluido en el repositorio con los valores correctos.

VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-anon-key"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"
