# =====================================================================
# Variables compartidas para docker-compose (raíz)
# Copia este archivo a .env y ajusta los valores antes de:
#   docker compose up --build -d
# =====================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234Ucp*
POSTGRES_DB=agendadocentedb
POSTGRES_PORT=5432

# Cadena de conexión usada por el backend.
# IMPORTANTE: el "*" en la contraseña debe ir URL-encoded como %2A.
DATABASE_URL=postgres://admin:1234Ucp%2A@db:5432/agendadocentedb

# ─── Puertos del host ─────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=5173

# ─── Backend ──────────────────────────────────────────────────────
JWT_SECRET=UCP_JWT_Secret_2025_CambiarEnProduccion
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=20

# ─── SMTP (recuperación de contraseña) ────────────────────────────
# Gmail: usar "App Password" (no la contraseña normal). Para el SMTP
# institucional UCP, sustituir host/puerto/usuario/clave.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=correo-sistema@ucp.edu.co
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM=Agenda Docente UCP <no-reply@ucp.edu.co>

# ─── Frontend (build-time) ────────────────────────────────────────
# En producción dentro de Docker el frontend usa /api (proxy nginx).
# En desarrollo local apuntar a http://localhost:4000/api.
VITE_API_URL=/api
