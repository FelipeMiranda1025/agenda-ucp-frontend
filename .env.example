# =============================================
# Variables compartidas por docker-compose
# Copia este archivo a .env antes de levantar
# =============================================

# ─── PostgreSQL ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agenda_ucp
POSTGRES_PORT=5432

# ─── Backend ─────────────────────────────────
BACKEND_PORT=3001
# Genera con: openssl rand -base64 32
JWT_SECRET=cambia-esto-en-produccion
# Lista separada por comas de orígenes permitidos
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ─── Frontend ────────────────────────────────
FRONTEND_PORT=8080
# URL pública del backend (usada por el frontend en build time)
VITE_API_URL=http://localhost:3001/api
