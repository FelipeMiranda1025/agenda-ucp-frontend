# =============================================
# Variables de entorno para Docker Compose
# Supabase Self-Hosted — Agenda Docente UCP
# =============================================
#
# 1. Copia este archivo:  cp .env.docker.example .env.docker
# 2. Genera los valores con los comandos del README.md
# 3. Ejecuta:  docker compose --env-file .env.docker up -d

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-password

# ─── JWT (genera con: openssl rand -base64 32) ─────────────
JWT_SECRET=your-jwt-secret-at-least-32-characters

# ─── Claves Supabase (genera con el script de Node.js del README) ──
ANON_KEY=your-generated-anon-key
SERVICE_ROLE_KEY=your-generated-service-role-key

# ─── Studio ─────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
